# ============================================================
# NOGIET Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/nogiet

# --- JWT Authentication ---
JWT_SECRET=your-jwt-secret-min-10-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-10-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:5173

# ============================================================
# EMISSION DATA SOURCES
# ============================================================

# --- Carbon Mapper ---
# The primary satellite methane detection source.
# Sign up at: https://data.carbonmapper.org/
# API docs:   https://api.carbonmapper.org/api/v1/docs
CARBON_MAPPER_API_URL=https://api.carbonmapper.org/api/v1
CARBON_MAPPER_EMAIL=
CARBON_MAPPER_PASSWORD=

# --- UNEP IMEO (International Methane Emissions Observatory) — API v2 ---
# v2 base path /api/v2/ (maintained). Auth: Authorization: Bearer <token>
# Docs: https://methanedata.unep.org/api/docs
# Use methanedata.unep.org — api.methanedata.unep.org often does not resolve (DNS).
IMEO_API_URL=https://methanedata.unep.org/api/v2
# Token from API docs Authorize (JWT or API key string)
IMEO_API_KEY=
# Client-provided NOGIET token sent as X-Nogiet-Token
IMEO_NOGIET_TOKEN=
# bearer (default) | x-api-key | both | auto
IMEO_AUTH_MODE=bearer
# Optional outbound proxy for IMEO traffic if Cloudflare blocks your IP (HTTP/HTTPS proxy URL)
# IMEO_PROXY_URL=http://user:pass@proxyhost:8080
# Optional Cloudflare clearance cookie (paste from a browser that solved the CF challenge)
# IMEO_COOKIE=cf_clearance=...
# ISO3 country filter for IMEO plumes (NGA = Nigeria only). `*` or `ALL` = global.
IMEO_COUNTRY_FILTER=NGA
# Sector filter for IMEO plumes (case-insensitive substring match, comma-separated).
# Default: keeps Oil and Gas only. `*` or `ALL` = every sector.
IMEO_SECTOR_FILTER=oil and gas
IMEO_UPLOAD_MAX_MB=50
MANUAL_UPLOAD_STORAGE_DIR=storage/manual-uploads
# Set true to log full IMEO JSON envelope + first raw record (server stdout)
IMEO_LOG_RESPONSE=false

# --- Sentinel-5P TROPOMI (Copernicus Data Space Ecosystem) ---
# ESA Copernicus satellite L2 methane (CH4) scene metadata.
# Catalogue browsing is PUBLIC — no API key required. A key is only needed
# when downloading the raw NetCDF granules referenced by S3Path, which this
# service does NOT do (it only surfaces scene metadata).
# Docs: https://documentation.dataspace.copernicus.eu/APIs/OData.html
TROPOMI_API_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
# Reserved for future raw-product download flows. Leave blank for catalogue-only.
TROPOMI_API_KEY=
# CDSE mission collection. Almost never needs changing.
TROPOMI_COLLECTION=SENTINEL-5P
# Product code per the TROPOMI guide: L2__CH4___ is the standard L2 methane product.
TROPOMI_PRODUCT_TYPE=L2__CH4___
# Look-back window in days for scene discovery. CDSE keeps roughly the last year.
TROPOMI_DAYS_BACK=30
# Hard cap on scenes returned — keeps the map uncluttered.
TROPOMI_MAX_RESULTS=50
# Optional bbox override (minLon,minLat,maxLon,maxLat). Defaults to Nigeria.
# Niger Delta only: TROPOMI_BBOX=4.5,4.0,9.5,6.5
# TROPOMI_BBOX=
# Sector label stamped onto every normalized TROPOMI scene. CDSE L2 CH4 scenes
# have no native sector field, so we synthesize one. Keep as "Oil and Gas" so
# TROPOMI participates in the platform's sector filter chain alongside IMEO
# and Carbon Mapper; set to e.g. "Satellite Coverage" to opt out of filtering.
TROPOMI_SECTOR_LABEL=Oil and Gas
# Spatial restriction: when true (default), only TROPOMI scenes whose
# AOI-clipped centroid falls inside a Nigerian oil block polygon (OML / OPL /
# Block) are kept. Scenes that grazed northern Nigeria but never crossed any
# oil-producing acreage are dropped. Set false to keep all scenes regardless.
TROPOMI_FILTER_TO_OIL_BLOCKS=true
# Set true to log the first raw CDSE record on each fetch (server stdout).
TROPOMI_LOG_RESPONSE=false
# Optional enhancement filter. 0 disables it; use 0.9 to keep only the top 10%.
TROPOMI_ENHANCEMENT_PERCENTILE=0
# Optional absolute CH4 floor. Leave blank to use percentile-only filtering.
# TROPOMI_MIN_CH4=
# Oil/gas-sector proxy. These defaults keep southern/onshore/offshore petroleum basins and remove northern non-industry background.
TROPOMI_OIL_BLOCK_TYPES=OML,OPL,Block
TROPOMI_OIL_GAS_BASINS=NIGER DLTA,BENIN EMBT,ANAM-NIGER,NIGER FAN,AVON FAN
# Google Earth Engine service-account config, shared by TROPOMI and EMIT below.
# Either set GEE_PRIVATE_KEY_JSON to the full JSON object, or set email + private key.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY=
# GEE_PRIVATE_KEY_JSON=

# NASA EMIT (L2B Methane Plume Complexes) via Google Earth Engine — reuses the
# GEE_* credentials above, no separate auth. Nigeria coverage is genuinely
# sparse (opportunistic global tasking), hence the long default look-back.
EMIT_DAYS_BACK=1500
EMIT_FILTER_TO_OIL_BLOCKS=true
EMIT_OIL_BLOCK_TYPES=OML,OPL,Block
EMIT_OIL_GAS_BASINS=NIGER DLTA,BENIN EMBT,ANAM-NIGER,NIGER FAN,AVON FAN
EMIT_LOG_RESPONSE=false

# ============================================================
# NOTIFICATIONS (optional)
# ============================================================

# --- Resend (Email) ---
RESEND_API_KEY=
EMAIL_FROM=NOGIET Portal <noreply@nogiet.gov.ng>

# --- Termii (SMS) ---
TERMII_API_KEY=
TERMII_SENDER_ID=NOGIET
TERMII_BASE_URL=https://v3.api.termii.com

# ============================================================
# FILE STORAGE (optional - Cloudflare R2)
# ============================================================

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nogiet
R2_PUBLIC_URL=
